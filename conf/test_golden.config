/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Golden test package (paper data subset; plan WP5, golden_test_package_plan.md)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PLACEHOLDER (WP0): the package is built in WP5 under tests/data/golden/. Paths below
    follow golden plan §4.10 and are finalised when the package is committed.

    One golden run per sequencing run, because preprocessing parameters are per run:
        nextflow run . -profile test_golden,<docker/singularity> --golden_experiment <name> --outdir <OUTDIR>

      endogenous_20250418  Figure 2, run 20250418  ont_adapter_mode = three_prime_only (D31)
      endogenous_20251022  Figure 2, run 20251022  defaults
      mpra_invitro         Figure 3 in vitro        defaults
      mpra_incell          Figure 3 in cellulo, run 20241114
                                                    orientation_adapters = pool, umi = false (D29)

    The non-default modes are set HERE ONLY, and only for these paper samples, whose libraries
    were built without the 5′ ONT adapter (20250418) or without ONT adapters and UMIs
    (20241114). All other data, including new MPRA in cellulo data, use the defaults
    (orientation_adapters = ont, ont_adapter_mode = linked, umi = true).
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Golden test profile'
    config_profile_description = 'Paper data subset (Figures 2 and 3) to check that an installation reproduces known results'
}

def golden_dir = "${projectDir}/tests/data/golden"
def golden = [
    endogenous_20250418: [dir: 'endogenous',   sheet: 'samplesheet_20250418.csv', library_type: 'endogenous', fasta: 'reference/endoG1G2.fa.gz',
                          ont_adapter_mode: 'three_prime_only'],
    endogenous_20251022: [dir: 'endogenous',   sheet: 'samplesheet_20251022.csv', library_type: 'endogenous', fasta: 'reference/endoG1G2.fa.gz'],
    mpra_invitro:        [dir: 'mpra_invitro', sheet: 'samplesheet.csv',          library_type: 'mpra',       fasta: 'reference/pool1.fa.gz'],
    mpra_incell:         [dir: 'mpra_incell',  sheet: 'samplesheet.csv',          library_type: 'mpra',       fasta: 'reference/pool1.fa.gz',
                          orientation_adapters: 'pool', umi: false],
]

if (params.golden_experiment) {
    def g = golden[params.golden_experiment]
    if (g == null) {
        throw new IllegalArgumentException("--golden_experiment must be one of ${golden.keySet()}")
    }
    params.input                = "${golden_dir}/${g.dir}/${g.sheet}"
    params.library_type         = g.library_type
    params.fasta                = "${golden_dir}/${g.dir}/${g.fasta}"
    params.bed                  = "${golden_dir}/${g.dir}/targets.bed"
    params.analyses             = "${golden_dir}/${g.dir}/analyses.yaml"
    params.bed_coordinates      = 'one_based_start' // golden delpos BEDs: start = end = 1-based site (R-15, G1-e)
    params.orientation_adapters = g.orientation_adapters ?: 'ont'
    params.ont_adapter_mode     = g.ont_adapter_mode ?: 'linked'
    params.umi                  = g.containsKey('umi') ? g.umi : true
}
