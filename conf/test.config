/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    WP0: stub data in tests/data/stub (wiring only; run with -stub).
    WP1 replaces it with the synthetic dataset in tests/data/synthetic.
    Use as follows:
        nextflow run rmrodell/nanomodamp -profile test,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input           = "${projectDir}/tests/data/stub/samplesheet.csv"
    library_type    = 'mpra'
    fasta           = "${projectDir}/tests/data/stub/ref.fa"
    bed             = "${projectDir}/tests/data/stub/targets.bed"
    bed_coordinates = 'one_based_start'
    analyses        = "${projectDir}/tests/data/stub/analyses.yaml"
}
