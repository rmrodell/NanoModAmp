/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Output layout: plan §4. Intermediate reads and BAMs are not published.
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        enabled: false
    ]

    /*
        PREPROCESS (plan §6.1). Arguments come from params; the mode (D29, D31) is chosen in
        subworkflows/local/preprocess. Linked adapters use ';required' on both ends so a read
        needs both adapters (D4, R-04); require_both_adapters = false drops it (diagnostics only).
    */
    // Step 2, linked orientation passes: ONT adapters, or pool adapters with orientation_adapters = 'pool' (D29)
    withName: 'CUTADAPT_SENSE' {
        ext.prefix = { "${meta.id}.trim1_sense" }
        ext.args   = { [
            "-m ${params.trim1_min_length} -O ${params.trim1_min_overlap} --discard-untrimmed",
            "-g '${params.orientation_adapters == 'pool' ? params.pool_adapter_5p : params.ont_adapter_sense_5p}${params.require_both_adapters ? ';required' : ''}" +
            "...${params.orientation_adapters == 'pool' ? params.pool_adapter_3p : params.ont_adapter_sense_3p}${params.require_both_adapters ? ';required' : ''}'"
        ].join(' ') }
    }
    withName: 'CUTADAPT_ANTISENSE' {
        ext.prefix = { "${meta.id}.trim1_antisense" }
        ext.args   = { [
            "-m ${params.trim1_min_length} -O ${params.trim1_min_overlap} --discard-untrimmed",
            "-g '${params.orientation_adapters == 'pool' ? params.pool_adapter_antisense_5p : params.ont_adapter_antisense_5p}${params.require_both_adapters ? ';required' : ''}" +
            "...${params.orientation_adapters == 'pool' ? params.pool_adapter_antisense_3p : params.ont_adapter_antisense_3p}${params.require_both_adapters ? ';required' : ''}'"
        ].join(' ') }
    }
    // Step 2 with ont_adapter_mode = 'three_prime_only' (D31, opt-in): legacy 3′-only trim, untrimmed reads kept
    withName: 'CUTADAPT_3PRIME' {
        ext.prefix = { "${meta.id}.trim1_3prime" }
        ext.args   = { "-m ${params.trim1_min_length} -O ${params.trim1_min_overlap} -a ${params.ont_adapter_sense_3p}" }
    }
    // Step 3: reverse-complement the antisense reads
    withName: 'SEQTK_RC' {
        ext.prefix = { "${meta.id}.antisense_rc" }
        ext.args   = '-r'
    }
    // Step 4: UMI from the 3′ end, appended to the read name with '_' (as UMICollapse expects)
    withName: 'UMITOOLS_EXTRACT' {
        ext.args   = { "--extract-method=string --bc-pattern=${params.umi_pattern} --3prime" }
    }
    // Step 5, MPRA only: pool adapters, both required
    withName: 'CUTADAPT_POOL' {
        ext.prefix = { "${meta.id}.trim2_pool" }
        ext.args   = { [
            "-m ${params.trim2_min_length} -O ${params.trim2_min_overlap} --discard-untrimmed",
            "-g '${params.pool_adapter_5p}${params.require_both_adapters ? ';required' : ''}...${params.pool_adapter_3p}${params.require_both_adapters ? ';required' : ''}'"
        ].join(' ') }
    }
    // Step 6: minimap2 arguments resolved per library type (D5), passed in meta by PREPROCESS
    withName: 'MINIMAP2_ALIGN' {
        ext.args   = { meta.minimap2_args }
    }
    // Step 7: -F {sam_exclude_flags}, then -q {min_mapq}
    withName: 'SAMTOOLS_VIEW_PRIMARY' {
        ext.prefix = { "${meta.id}.primary" }
        ext.args   = { "--output-fmt bam -F ${params.sam_exclude_flags}" }
    }
    withName: 'SAMTOOLS_VIEW_MAPQ' {
        ext.prefix = { "${meta.id}.mapq_filtered" }
        ext.args   = { "--output-fmt bam -q ${params.min_mapq}" }
        // bam/<sample>.bam: final BAM when umi = false
        publishDir = [
            path: { "${params.outdir}/bam" },
            mode: params.publish_dir_mode,
            enabled: !params.umi,
            saveAs: { filename -> filename.endsWith('.bam') ? "${meta.id}.bam" : null }
        ]
    }
    withName: 'SAMTOOLS_INDEX_FILTERED' {
        publishDir = [
            path: { "${params.outdir}/bam" },
            mode: params.publish_dir_mode,
            enabled: !params.umi,
            saveAs: { filename -> filename.endsWith('.bai') ? "${meta.id}.bam.bai" : null }
        ]
    }
    // Step 8: UMICollapse, default settings (D7)
    withName: 'UMICOLLAPSE' {
        ext.prefix = { "${meta.id}.dedup" }
        ext.args   = { params.umicollapse_args ?: '' }
        publishDir = [
            [
                path: { "${params.outdir}/preprocess/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/bam" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.endsWith('.bam') ? "${meta.id}.bam" : null }
            ]
        ]
    }
    withName: 'SAMTOOLS_INDEX_DEDUP' {
        publishDir = [
            path: { "${params.outdir}/bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.bai') ? "${meta.id}.bam.bai" : null }
        ]
    }

    // preprocess/<sample>/: tool logs
    withName: 'CUTADAPT_SENSE|CUTADAPT_ANTISENSE|CUTADAPT_POOL|CUTADAPT_3PRIME|UMITOOLS_EXTRACT|MERGE_ORIENT' {
        publishDir = [
            path: { "${params.outdir}/preprocess/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{log,tsv}'
        ]
    }

    withName: 'COUNT' {
        ext.args = {
            [
                "--bed-coordinates ${params.bed_coordinates}",
                "--min-coverage ${params.min_coverage}",
                "--max-depth ${params.pileup_max_depth}",
                "--min-mapq ${params.pileup_min_mapq}",
                "--min-base-quality ${params.pileup_min_base_quality}",
                params.count_all_bases ? '--all-bases' : '',
                params.allow_region_failures ? '--allow-region-failures' : ''
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/counts/per_sample" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MERGE_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/counts" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'MERGE_COUNT_TABLES' {
        publishDir = [
            path: { "${params.outdir}/counts" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BACKGROUND_QC' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CALL_SITES' {
        publishDir = [
            path: { "${params.outdir}/calling" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'SITE_SETS' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
}
