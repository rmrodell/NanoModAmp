{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/rmrodell/NanoModAmp/main/assets/schema_analyses.json",
    "title": "rmrodell/nanomodamp - analyses config",
    "description": "Analyses config contract (plan §5.4).",
    "type": "object",
    "required": ["analyses"],
    "additionalProperties": false,
    "properties": {
        "analyses": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["name", "type"],
                "additionalProperties": false,
                "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                    "type": { "type": "string", "enum": ["treatment", "factor"] },
                    "subset": {
                        "type": "object",
                        "description": "Sample-sheet column -> allowed values",
                        "additionalProperties": { "type": "array", "items": { "type": ["string", "integer"] }, "minItems": 1 }
                    },
                    "random_effects": { "type": "string", "default": "", "description": "Extra terms appended to the model formula" },
                    "sesoi": { "type": "number", "default": 0.05, "exclusiveMinimum": 0, "maximum": 1 },
                    "fdr": { "type": "number", "default": 0.05, "exclusiveMinimum": 0, "maximum": 1 },
                    "plot_all_sites": { "type": "boolean" },
                    "colors": { "type": "object", "additionalProperties": { "type": "string" } },
                    "factor": { "type": "string", "description": "factor analyses only: sample-sheet column" },
                    "levels": {
                        "type": "array", "minItems": 2, "maxItems": 2,
                        "items": { "type": ["string", "integer"] },
                        "description": "factor analyses only: [baseline, experimental]"
                    },
                    "direction": { "type": "string", "enum": ["positive", "both"], "default": "positive" },
                    "p_adjust": { "type": "string", "enum": ["BH", "legacy"], "default": "BH", "description": "BH across the tested sites of the analysis (default), or legacy: the paper's per-site no-op (R-30)" }
                },
                "if": { "properties": { "type": { "const": "factor" } } },
                "then": { "required": ["factor", "levels"] }
            }
        },
        "site_sets": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "op", "of"],
                "additionalProperties": false,
                "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                    "op": { "type": "string", "enum": ["union", "intersection", "difference"] },
                    "of": { "type": "array", "minItems": 2, "items": { "type": "string" } },
                    "quartiles_by": {
                        "type": "object",
                        "required": ["analysis", "column"],
                        "properties": { "analysis": { "type": "string" }, "column": { "type": "string" } }
                    }
                }
            }
        }
    }
}
