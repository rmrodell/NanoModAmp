    Biostrings,
    blme,
    car,
    data.table,
    dplyr,
    forcats,
    furrr,
    future,
    future.apply,
    GenomeInfoDb,
    GenomicRanges,
    ggplot2,
    IRanges,
    lme4,
    readr,
    rlang,
    Rsamtools,
    S4Vectors,
    stats,
    tidyr,
    utils,
    yaml
Suggests:
    testthat (>= 3.0.0)
Config/testthat/edition: 3
